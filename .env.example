# Pick a provider at runtime with --provider. All optional — local Ollama needs none.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Local gateway (Ollama exposes an OpenAI-compatible endpoint)
MUSAEUS_LOCAL_BASE_URL=http://localhost:11434/v1
MUSAEUS_LOCAL_MODEL=gemma3
# Per-provider model overrides (defaults live in config.py)
#MUSAEUS_ANTHROPIC_MODEL=claude-opus-5
#MUSAEUS_OPENAI_MODEL=gpt-5-mini
#MUSAEUS_GOOGLE_MODEL=gemini-flash-latest
